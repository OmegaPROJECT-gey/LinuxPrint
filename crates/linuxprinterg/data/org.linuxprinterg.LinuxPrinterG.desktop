[Desktop Entry]
Type=Application
Name=LinuxPrinterG
Name[ru]=LinuxPrinterG
GenericName=Printing and scanning center
GenericName[ru]=Центр управления печатью и сканированием
Comment=Manage printers and scanners through CUPS and SANE
Comment[ru]=Управление принтерами и сканерами через CUPS и SANE
Exec=linuxprinterg %F
Icon=org.linuxprinterg.LinuxPrinterG
Terminal=false
MimeType=image/png;image/jpeg;image/tiff;image/webp;image/bmp;application/pdf;text/plain;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;
Categories=Office;GTK;
Keywords=print;scan;cups;sane;printer;scanner;
Keywords[ru]=печать;скан;принтер;сканер;cups;sane;
StartupNotify=true
