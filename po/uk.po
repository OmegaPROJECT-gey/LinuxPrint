msgid "err-permission"
msgstr "Немає доступу: {msg}"

# EN: Install the cups-client package (Debian/Ubuntu: cups-client, Fedora: cups-client, Arch: cups) and make sure the cups service is running.
msgid "help-install-cups"
msgstr "Встановіть пакет cups-client (Debian/Ubuntu: cups-client, Fedora: cups-client, Arch: cups) і переконайтеся, що служба cups працює."

# EN: Install sane-backends (Debian/Ubuntu: sane-utils, Fedora: sane-backends, Arch: sane). For AirScan/eSCL scanners install the escl backend too.
msgid "help-install-sane"
msgstr "Встановіть sane-backends (Debian/Ubuntu: sane-utils, Fedora: sane-backends, Arch: sane). Для сканерів AirScan/eSCL встановіть також backend escl."

# EN: Install tesseract-ocr and language data (e.g. tesseract-ocr-rus).
msgid "help-install-tesseract"
msgstr "Встановіть tesseract-ocr і мовні дані (напр., tesseract-ocr-ukr)."

# EN: Install poppler-utils for PDF preview.
msgid "help-install-poppler"
msgstr "Встановіть poppler-utils для перегляду PDF."

# EN: Install LibreOffice for automatic DOCX/ODT conversion, or save the document as PDF.
msgid "help-install-libreoffice"
msgstr "Встановіть LibreOffice для автоматичного перетворення DOCX/ODT або збережіть документ у форматі PDF."

# EN: Check that your user is in the lpadmin/sane groups and has write access to the target folder.
msgid "help-permission"
msgstr "Перевірте, що ваш користувач належить до груп lpadmin/sane і має право запису до цільового каталогу."


